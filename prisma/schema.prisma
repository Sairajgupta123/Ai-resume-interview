generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Interview {
  // Nullable during the staged legacy-data backfill; employer APIs must not infer ownership from null.\n  organizationId  String?\n  organization    EmployerOrganization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)\n  id              String   @id @default(cuid())
  candidateName   String
  role            String
  mode            String   @default("live")
  status          String   @default("completed")
  resumeText      String
  jobDescription  String
  reportJson      String?
  overallScore    Int?
  recommendation  String?
  recordingPath   String?
  candidateEmail  String?
  invitationTokenHash String? @unique
  inviteExpiresAt DateTime?
  inviteUsedAt    DateTime?
  startedAt       DateTime?
  startLockAt     DateTime?
  answerLockAt    DateTime?
  reportLockAt    DateTime?
  consentAcceptedAt DateTime?
  consentVersion    String?
  employerDecision String?
  employerNotes    String?
  decisionAt       DateTime?
  durationSeconds Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  messages        InterviewMessage[]
  decisionHistory EmployerDecisionHistory[]
  signals         InterviewSignal[]
  recordingAccessEvents RecordingAccessEvent[]
  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@index([candidateName])
}


model EmployerUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String?
  disabledAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  memberships  EmployerMembership[]

  @@index([disabledAt])
}

model EmployerOrganization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships EmployerMembership[]
  interviews  Interview[]
}

model EmployerMembership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           EmployerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   EmployerOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model RecordingAccessEvent {
  id          String    @id @default(cuid())
  interviewId String
  method      String
  outcome     String
  createdAt   DateTime  @default(now())
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, createdAt])
}

model LoginAttempt {
  id              String   @id @default(cuid())
  key             String   @unique
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt

  @@index([blockedUntil])
}

model InterviewMessage {
  id          String    @id @default(cuid())
  interviewId String
  role        String
  content     String
  createdAt   DateTime  @default(now())
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  @@index([interviewId, createdAt])
}

model EmployerDecisionHistory {
  id          String    @id @default(cuid())
  interviewId String
  decision    String
  notes       String?
  createdAt   DateTime  @default(now())
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, createdAt])
}

model InterviewSignal {
  id          String    @id @default(cuid())
  interviewId String
  sender      String
  kind        String
  payload     String
  createdAt   DateTime  @default(now())
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId, createdAt])
}

model PrivacyDeletionRequest {
  id                    String   @id @default(cuid())
  interviewId           String
  candidateNameSnapshot String
  candidateEmailSnapshot String?
  roleSnapshot          String
  reason                String
  status                String   @default("pending_candidate_verification")
  requestedBy           String
  verificationTokenHash String?  @unique
  verificationExpiresAt DateTime?
  verificationSentAt    DateTime?
  verifiedAt            DateTime?
  verificationAttempts  Int      @default(0)
  deletionAttempts      Int      @default(0)
  executionStartedAt    DateTime?
  executionLeaseToken   String?  @unique
  completedAt           DateTime?
  lastErrorCode         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  events                PrivacyDeletionEvent[]
  @@unique([interviewId])
  @@index([createdAt])
}

model PrivacyDeletionEvent {
  id          String   @id @default(cuid())
  requestId   String
  action      String
  actor       String
  details     String?
  createdAt   DateTime @default(now())
  request     PrivacyDeletionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@index([requestId, createdAt])
}
