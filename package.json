{
  "name": "mzobs-ai-interview",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma migrate dev && next dev",
    "build": "prisma generate && prisma generate --schema prisma/schema.sqlite.prisma && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:validate": "prisma validate",
    "postinstall": "prisma generate && prisma generate --schema prisma/schema.sqlite.prisma",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate && prisma generate --schema prisma/schema.sqlite.prisma",
    "db:validate:sqlite": "prisma validate --schema prisma/schema.sqlite.prisma",
    "db:import-sqlite": "node scripts/import-sqlite-to-postgres.cjs"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.0.9",
    "react-dom": "19.0.9",
    "@prisma/client": "6.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.8.2",
    "prisma": "6.5.0"
  }
}
