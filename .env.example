# xAI Grok API
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-3-mini

# Local SQLite database
DATABASE_URL="file:../dev.db"

# Employer dashboard credentials (change before use)
EMPLOYER_USERNAME=admin
EMPLOYER_PASSWORD=change-this-to-a-long-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional TURN REST API credentials (keep the shared secret server-side only; never prefix these with NEXT_PUBLIC_)
TURN_URL=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Candidate deletion verification email (Resend)
RESEND_API_KEY=
PRIVACY_FROM_EMAIL=
# Local development: http://localhost:3000
# Production: set this to the public HTTPS origin, e.g. https://interviews.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional interview retention preview (whole days, 1-3650); unset disables eligibility preview
INTERVIEW_RETENTION_DAYS=

# Private S3-compatible recording storage (AWS S3, Cloudflare R2, MinIO, etc.)
# Required in production; local development can continue using data/recordings.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Required in production for the scheduled internal recording-cleanup worker; use a unique random value of at least 32 characters
CRON_SECRET=
