# xAI Grok API
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-3-mini

# Local SQLite database
DATABASE_URL="file:../dev.db"

# Employer dashboard credentials (change before use)
EMPLOYER_USERNAME=admin
EMPLOYER_PASSWORD=change-this-to-a-long-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional TURN REST API credentials (keep the shared secret server-side only; never prefix these with NEXT_PUBLIC_)
TURN_URL=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
